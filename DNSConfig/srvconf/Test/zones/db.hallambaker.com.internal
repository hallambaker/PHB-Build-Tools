; PATH=/etc/bind/zones/db.hallambaker.com
; 
; DNS Zone file for hallambaker.com using DNS setup Default
;
; This file is automatically generated CHANGES WILL BE OVERWRITTEN!
;
$TTL 600
hallambaker.com.      IN      SOA     dns1.hallambaker.com. hallam.gmail.com. (
                        2026060201       ; serial, todays date + todays serial 
                        3600              ; refresh, seconds
                        1800              ; retry, seconds
                        3600000              ; expire, seconds
                        600 )            ; minimum, seconds

; Additional name servers
hallambaker.com.     IN      NS      dns1.hallambaker.com.
dns1.hallambaker.com.    A 10.0.0.4


qqq.hallambaker.com.    A 10.0.0.4


hallambaker.com.    IN     CAA 0 issue "letsencrypt.org"
hallambaker.com.    IN     CAA 0 issuewild  ";"
hallambaker.com.    IN     CAA 0 iodef "mailto:hostmaster@hallambaker.com"

; Hardcoded A records
ui.hallambaker.com.    A 10.0.0.1
ui.hallambaker.com.        IN      TXT    "v=spf1 Gateway ?all"  
minecraft.hallambaker.com.    A 10.0.0.14
minecraft.hallambaker.com.        IN      TXT    "v=spf1 Gateway ?all"  
homeassistant.hallambaker.com.    A 10.0.0.16
homeassistant.hallambaker.com.        IN      TXT    "v=spf1 Proxy ?all"  
jellyfin.hallambaker.com.    A 10.0.0.10
jellyfin.hallambaker.com.        IN      TXT    "v=spf1 Proxy ?all"  
prod1.hallambaker.com.    A 96.237.102.35
prod1.hallambaker.com.        IN      TXT    "v=spf1 PROD1 ?all"  
prod2.hallambaker.com.    A 96.237.102.36
prod2.hallambaker.com.        IN      TXT    "v=spf1 PROD2 ?all"  
dev1.hallambaker.com.    A 96.237.102.37
dev1.hallambaker.com.        IN      TXT    "v=spf1 DEV1 ?all"  
dev2.hallambaker.com.    A 96.237.102.38
dev2.hallambaker.com.        IN      TXT    "v=spf1 DEV2 ?all"  

; explicit mail
hallambaker.com.       IN      MX       10 mx01.ionos.com.
hallambaker.com.       IN      MX       10 mx00.ionos.com.
hallambaker.com. TXT "v=spf1 redirect=_spf.google.com"



; Host host1.cryptomesh.org 96.237.102.35 
hallambaker.com.    A 10.0.0.12
; is wildcard
*.hallambaker.com.    A 10.0.0.12
www.hallambaker.com.    A 10.0.0.12
http.hallambaker.com.    A 10.0.0.12
https.hallambaker.com.    A 10.0.0.12
_http._tcp.hallambaker.com.  IN    SRV 1 1 80 hallambaker.com.
_https._tcp.hallambaker.com.   IN   SRV 1 1 443 hallambaker.com.


; handles
_atproto.phill.hallambaker.com. IN TXT "did=did:plc:k647x4n6h3jm347u3t5cm6ki"
phill.hallambaker.com.    A 96.237.102.35 
