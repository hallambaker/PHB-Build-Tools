; PATH=/etc/bind/zones/db.mathmesh.net
; 
; DNS Zone file for mathmesh.net using DNS setup Default
;
; This file is automatically generated CHANGES WILL BE OVERWRITTEN!
;
$TTL 600
mathmesh.net.      IN      SOA     dns1.mathmesh.net. hallam.gmail.com. (
                        2026071401       ; serial, todays date + todays serial 
                        3600              ; refresh, seconds
                        1800              ; retry, seconds
                        3600000              ; expire, seconds
                        600 )            ; minimum, seconds

; Additional name servers
mathmesh.net.     IN      NS      dns1.mathmesh.net.
dns1.mathmesh.net.    A 96.237.102.35 
mathmesh.net.     IN      NS      dns2.mathmesh.net.
dns2.mathmesh.net.    A 96.237.102.36 


mathmesh.net.    IN     CAA 0 issue "letsencrypt.org"
mathmesh.net.    IN     CAA 0 issuewild  ";"
mathmesh.net.    IN     CAA 0 iodef "mailto:hostmaster@hallambaker.com"

; Hardcoded A records

; default mail
mathmesh.net.       IN      MX       10 mx01.ionos.com.
mathmesh.net.       IN      MX       10 mx00.ionos.com.
mathmesh.net. TXT "v=spf1 redirect=_spf.google.com"



; Host host1.cryptomesh.org 96.237.102.35 
mathmesh.net.    A 96.237.102.35 
www.mathmesh.net.    A 96.237.102.35 
http.mathmesh.net.    A 96.237.102.35
https.mathmesh.net.    A 96.237.102.35 
_http._tcp.mathmesh.net.  IN    SRV 1 1 80 host1.cryptomesh.org.
_https._tcp.mathmesh.net.   IN   SRV 1 1 443 host1.cryptomesh.org.


; handles
; mesh handles
