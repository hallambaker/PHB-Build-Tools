; PATH=/etc/bind/zones/db.example.net
; 
; DNS Zone file for example.net using DNS setup Default
;
; This file is automatically generated CHANGES WILL BE OVERWRITTEN!
;
$TTL 600
example.net.      IN      SOA     dns1.example.net. hallam.gmail.com. (
                        2026071401       ; serial, todays date + todays serial 
                        3600              ; refresh, seconds
                        1800              ; retry, seconds
                        3600000              ; expire, seconds
                        600 )            ; minimum, seconds

; Additional name servers
example.net.     IN      NS      dns1.example.net.
dns1.example.net.    A 96.237.102.35 
example.net.     IN      NS      dns2.example.net.
dns2.example.net.    A 96.237.102.36 


example.net.    IN     CAA 0 issue "letsencrypt.org"
example.net.    IN     CAA 0 issuewild  ";"
example.net.    IN     CAA 0 iodef "mailto:hostmaster@hallambaker.com"

; Hardcoded A records
host1.example.net.    A 96.237.102.37
host1.example.net.        IN      TXT    "v=spf1 DEV1 ?all"  
host2.example.net.    A 96.237.102.38
host2.example.net.        IN      TXT    "v=spf1 DEV2 ?all"  

; default mail
example.net.       IN      MX       10 mx01.ionos.com.
example.net.       IN      MX       10 mx00.ionos.com.
example.net. TXT "v=spf1 redirect=_spf.google.com"



; Host dev1.hallambaker.com 96.237.102.37 
example.net.    A 96.237.102.37 
www.example.net.    A 96.237.102.37 
http.example.net.    A 96.237.102.37
https.example.net.    A 96.237.102.37 
_http._tcp.example.net.  IN    SRV 1 1 80 dev1.hallambaker.com.
_https._tcp.example.net.   IN   SRV 1 1 443 dev1.hallambaker.com.


; handles
; mesh handles
_mesh.alice.example.net. IN TXT "dsa=maua-f6qe-ejui-gbwr-c4bh-4x5o-tlah@@example.com"
alice.example.net.    A 96.237.102.37 
