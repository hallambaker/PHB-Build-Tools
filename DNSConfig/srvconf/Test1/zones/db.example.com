; PATH=/etc/bind/zones/db.example.com
; 
; DNS Zone file for example.com using DNS setup Default
;
; This file is automatically generated CHANGES WILL BE OVERWRITTEN!
;
$TTL 600
example.com.      IN      SOA     dns1.example.com. hallam.gmail.com. (
                        2026071401       ; serial, todays date + todays serial 
                        3600              ; refresh, seconds
                        1800              ; retry, seconds
                        3600000              ; expire, seconds
                        600 )            ; minimum, seconds

; Additional name servers
example.com.     IN      NS      dns1.example.com.
dns1.example.com.    A 96.237.102.35 
example.com.     IN      NS      dns2.example.com.
dns2.example.com.    A 96.237.102.36 


example.com.    IN     CAA 0 issue "letsencrypt.org"
example.com.    IN     CAA 0 issuewild  ";"
example.com.    IN     CAA 0 iodef "mailto:hostmaster@hallambaker.com"

; Hardcoded A records
host1.example.com.    A 96.237.102.37
host1.example.com.        IN      TXT    "v=spf1 DEV1 ?all"  
host2.example.com.    A 96.237.102.38
host2.example.com.        IN      TXT    "v=spf1 DEV2 ?all"  

; default mail
example.com.       IN      MX       10 mx01.ionos.com.
example.com.       IN      MX       10 mx00.ionos.com.
example.com. TXT "v=spf1 redirect=_spf.google.com"



; Host dev1.hallambaker.com 96.237.102.37 
example.com.    A 96.237.102.37 
www.example.com.    A 96.237.102.37 
http.example.com.    A 96.237.102.37
https.example.com.    A 96.237.102.37 
_http._tcp.example.com.  IN    SRV 1 1 80 dev1.hallambaker.com.
_https._tcp.example.com.   IN   SRV 1 1 443 dev1.hallambaker.com.


; handles
; mesh handles
